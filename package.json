{
  "name": "todo-list",
  "version": "1.2.0",
  "description": "简洁好看的待办清单",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "qq298",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.qq298.todo",
    "productName": "待办清单",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "待办清单"
    }
  }
}
